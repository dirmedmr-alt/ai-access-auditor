{
  "name": "ai-access-auditor",
  "productName": "AI Access Auditor",
  "version": "1.0.10",
  "description": "Find and revoke the access you've given AI agents",
  "homepage": "https://dirmedmr-alt.github.io/ai-access-auditor/",
  "author": {
    "name": "dirmedmr-alt",
    "email": "260786838+dirmedmr-alt@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node gen-strings.js --check && electron-builder --linux --publish never",
    "dist:win": "node gen-strings.js --check && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.4.0"
  },
  "build": {
    "appId": "local.ai-access-auditor",
    "productName": "AI Access Auditor",
    "artifactName": "AI-Access-Auditor-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "popup.html",
      "popup-preload.js",
      "strings.json",
      "build/icon.png",
      "build/tray*.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server.js",
        "to": "core/server.js"
      },
      {
        "from": "../gate.js",
        "to": "core/gate.js"
      },
      {
        "from": "../public",
        "to": "core/public"
      },
      {
        "from": "../LICENSE",
        "to": "core/LICENSE"
      }
    ],
    "afterPack": "./after-pack.js",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Security",
      "icon": "build/icon.png",
      "executableName": "ai-access-auditor",
      "synopsis": "See and take back the access AI agents have",
      "desktop": {
        "entry": {
          "StartupWMClass": "AI Access Auditor"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libnotify4",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libdrm2",
        "libxkbcommon0",
        "iproute2",
        "procps"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "AI-Access-Auditor-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "AI Access Auditor",
      "uninstallDisplayName": "AI Access Auditor",
      "deleteAppDataOnUninstall": false,
      "artifactName": "AI-Access-Auditor-${version}-windows-${arch}.${ext}"
    }
  }
}
